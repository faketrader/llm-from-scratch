% 图表可对称侵入页边距，正文版心与行长保持不变。
% 4 mm 出血后，内侧仍保留 15 mm，外侧仍保留 12 mm。
\newlength{\myfloatbleed}
\setlength{\myfloatbleed}{4mm}
\ifdefined\HCode
  \NewDocumentEnvironment{mywidefloat}{}{}{}
  \NewDocumentEnvironment{widetable}{O{tbp}}{\begin{table}[#1]}{\end{table}}
  \NewDocumentEnvironment{table*}{O{tbp}}{\begin{table}[#1]}{\end{table}}
\else
  \NewDocumentEnvironment{mywidefloat}{}
    {\begin{adjustwidth}{-\myfloatbleed}{-\myfloatbleed}\captionsetup{width=\linewidth}}
    {\end{adjustwidth}}
  \let\myoriginalfigure\figure
  \let\myendoriginalfigure\endfigure
  \RenewDocumentEnvironment{figure}{O{tbp}}
    {\myoriginalfigure[#1]\begin{mywidefloat}}
    {\end{mywidefloat}\myendoriginalfigure}
  \let\myoriginaltable\table
  \let\myendoriginaltable\endtable

  % 表格默认保持在正文版心内（\textwidth），在必要时才超出版面侵入页边距。
  % 当表格列数较多需要超出版面时，使用 table* 或 widetable 环境，或 table[wide]，亦可在 table 内直接使用 mywidefloat。
  \ExplSyntaxOn
  \bool_new:N \l__myformat_table_wide_bool
  \tl_new:N \l__myformat_table_pos_tl

  \cs_new_protected:Npn \__myformat_parse_table_opt:n #1
    {
      \tl_set:Nn \l__myformat_table_pos_tl { #1 }
      \tl_if_in:NnTF \l__myformat_table_pos_tl { wide }
        {
          \bool_set_true:N \l__myformat_table_wide_bool
          \tl_replace_all:Nnn \l__myformat_table_pos_tl { wide } { }
          \tl_replace_all:Nnn \l__myformat_table_pos_tl { , } { }
          \tl_trim_spaces:N \l__myformat_table_pos_tl
          \tl_if_empty:NT \l__myformat_table_pos_tl
            { \tl_set:Nn \l__myformat_table_pos_tl { tbp } }
        }
        {
          \bool_set_false:N \l__myformat_table_wide_bool
        }
    }

  \cs_new_protected:Npn \__myformat_begin_table:n #1
    {
      \myoriginaltable[#1]
    }

  \RenewDocumentEnvironment{table}{O{tbp}}
    {
      \__myformat_parse_table_opt:n { #1 }
      \exp_args:NV \__myformat_begin_table:n \l__myformat_table_pos_tl
      \bool_if:NT \l__myformat_table_wide_bool
        { \begin{mywidefloat} }
    }
    {
      \bool_if:NT \l__myformat_table_wide_bool
        { \end{mywidefloat} }
      \myendoriginaltable
    }

  \RenewDocumentEnvironment{table*}{O{tbp}}
    {
      \myoriginaltable[#1]
      \begin{mywidefloat}
    }
    {
      \end{mywidefloat}
      \myendoriginaltable
    }

  \NewDocumentEnvironment{widetable}{O{tbp}}
    {
      \myoriginaltable[#1]
      \begin{mywidefloat}
    }
    {
      \end{mywidefloat}
      \myendoriginaltable
    }
  \ExplSyntaxOff
\fi

% 图题使用非浮动位置，链接锚点落在图题处；表题统一置于表体上方。
\captionsetup{hypcap=false}
\ifdefined\HCode\else
  \captionsetup{font=small,labelfont={bf,sf}}
\fi
\captionsetup[figure]{width=\textwidth}
\captionsetup[table]{position=top,width=\textwidth}

% 表体统一使用小字号；表题继续由 caption 包独立控制。
\AtBeginEnvironment{tabular}{\small}
\AtBeginEnvironment{tabularx}{\small}
\AtBeginEnvironment{longtable}{\small}

\newcommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\DeclareRobustCommand{\bookcode}[1]{\texttt{\seqsplit{#1}}}
\DefineVerbatimEnvironment{verbatim}{Verbatim}{breaklines=true,fontsize=\small}

\RequirePackage{microtype}
\RequirePackage{fancyhdr}
\RequirePackage{emptypage} % 双页清页插入的空白页不显示页眉页脚。

\newcommand{\my@partfigure}{}
\newcommand{\partfigure}[1]{\gdef\my@partfigure{#1}}
\newcommand{\my@render@partfigure}{%
  \ifx\my@partfigure\@empty\else
    \par\vspace{10mm}%
    \centering
    \IfFileExists{\my@partfigure}{%
      \includegraphics[width=0.96\linewidth]{\my@partfigure}%
    }{%
      \IfFileExists{book/\my@partfigure}{%
        \includegraphics[width=0.96\linewidth]{book/\my@partfigure}%
      }{%
        \IfFileExists{../\my@partfigure}{%
          \includegraphics[width=0.96\linewidth]{../\my@partfigure}%
        }{%
          \includegraphics[width=0.96\linewidth]{\subfix{\my@partfigure}}%
        }%
      }%
    }%
    \gdef\my@partfigure{}%
  \fi
}

% 纸书正文保留衬线字体；各级标题追加黑体与非衬线西文字体，沿用 ctex 原有字号和间距。
% 网页标题由 CSS 统一控制，避免把纸书字体命令送入 TeX4ht。
\ifdefined\HCode\else
  \ctexset{
    part/name={第,篇},
    part/format+={\heiti\sffamily},
    part/beforeskip=20pt,
    part/afterskip=0pt plus 1fil,
    part/aftertitle={\my@render@partfigure},
    chapter/format+={\heiti\sffamily},
    section/format+={\heiti\sffamily},
    subsection/format+={\heiti\sffamily},
    subsubsection/format+={\heiti\sffamily}
  }
\fi
\setlength{\parindent}{2em}
% 普通行仍使用类默认行距；仅当行内公式使相邻行净空过小时增加间距。
\setlength{\lineskiplimit}{2pt}
\setlength{\lineskip}{3pt}
\setlength{\emergencystretch}{2em}
% 禁止同一条脚注跨页拆分；空间不足时由正文分页为完整脚注让位。
\interfootnotelinepenalty=10000
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\nouppercase{\leftmark}}
\fancyhead[RO]{\small\nouppercase{\rightmark}}
\fancyfoot[LE,RO]{\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[LE,RO]{\thepage}\renewcommand{\headrulewidth}{0pt}}

