\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{my-format}[2026/09/18 My book formatting: figures, tables, and typography]

\RequirePackage{iftex}
\RequireTUTeX

% 中文字体由 ctex 类选项配置；纸书西文正文使用 Pagella，与数学字形区分。
% 按 TeX Live 文件名加载，避免依赖操作系统字体索引。
\ifdefined\HCode
  \newcommand{\myheadingfont}{\bfseries}
\else
  \setmainfont{texgyrepagella}[
    Extension=.otf,
    UprightFont=*-regular,
    BoldFont=*-bold,
    ItalicFont=*-italic,
    BoldItalicFont=*-bolditalic
  ]
  % 全角中文标点（包括弯引号）跟随当前 CJK 字体族，不使用西文正文字体。
  \ifXeTeX
    \xeCJKsetup{PunctFamily=false}
    % 将罗马数字与带圈数字映射至 CJK 字体，防止西文字体缺失字符。
    \xeCJKDeclareCharClass{CJK}{"2160->"217F,"2460->"2473}
  \fi
  \newcommand{\myheadingfont}{\bfseries\heiti\sffamily}
\fi

