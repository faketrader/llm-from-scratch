  paperwidth=185mm,
  paperheight=260mm,
  inner=19mm,
  outer=16mm,
  top=22mm,
  bottom=22mm,
  headheight=16pt
]{geometry}
% 内侧 19 mm 已包含装订余量；边注只占外侧，不侵入装订沟。
\setlength{\marginparwidth}{10mm}
\setlength{\marginparsep}{2.5mm}

