\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{my-format}[2026/09/18 My book formatting and figures]

\RequirePackage{iftex}
\RequireTUTeX

% 中文沿用 ctex 平台默认字体；纸书西文正文使用 Pagella，与数学字形区分。
% 按 TeX Live 文件名加载，避免依赖操作系统字体索引。
\ifdefined\HCode
  \newcommand{\myheadingfont}{\bfseries}
\else
  \setmainfont{texgyrepagella}[
    Extension=.otf,
    UprightFont=*-regular,
    BoldFont=*-bold,
    ItalicFont=*-italic,
    BoldItalicFont=*-bolditalic
  ]
  % 全角中文标点（包括弯引号）跟随当前 CJK 字体族，不使用西文正文字体。
  \ifXeTeX
    \xeCJKsetup{PunctFamily=false}
  \fi
  \newcommand{\myheadingfont}{\bfseries\heiti\sffamily}
\fi

% 正度16开成品尺寸：185 mm × 260 mm。
\RequirePackage[
  paperwidth=185mm,
  paperheight=260mm,
  inner=30mm,
  outer=24mm,
  top=26mm,
  bottom=26mm,
  headheight=16pt
]{geometry}
% 内侧 30 mm 已包含装订余量；边注只占外侧，不侵入装订沟。
\setlength{\marginparwidth}{17mm}
\setlength{\marginparsep}{3mm}

\RequirePackage{siunitx}
\sisetup{mode=match}
\RequirePackage{enumitem}
\RequirePackage{seqsplit,fvextra}

\RequirePackage{newunicodechar}
% 中文科技排版
\newunicodechar{。}{．}

\RequirePackage{xcolor}
