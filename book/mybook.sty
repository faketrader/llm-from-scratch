% 颜色辅助识别，标题仍明确类别，保证灰度打印可读。
\tcbset{
  lfsbox/.style={
    enhanced,breakable,colback=LFSLight,
    colframe=LFSBorder,coltitle=LFSNavy,colbacktitle=LFSLight,
    fonttitle=\bfseries,boxrule=.4pt,arc=1mm,left=2mm,right=2mm,
    top=1.5mm,bottom=1.5mm,before skip=8pt,after skip=8pt
  },
  lfsalert/.style={
    enhanced,breakable,frame hidden,boxrule=0pt,arc=0mm,
    left=3mm,right=2.5mm,top=2mm,bottom=2mm,
    fonttitle=\bfseries,toptitle=0mm,bottomtitle=1mm,
    before skip=8pt,after skip=8pt
  }
}
\newtcolorbox{note}[1][]{
  lfsalert,colback=LFSAlertNoteBack,colbacktitle=LFSAlertNoteBack,
  coltitle=LFSAlertNote,title={\ifstrempty{#1}{NOTE}{NOTE：#1}},
  borderline west={1.5pt}{0pt}{LFSAlertNote}}
\newtcolorbox{tip}[1][]{
  lfsalert,colback=LFSAlertTipBack,colbacktitle=LFSAlertTipBack,
  coltitle=LFSAlertTip,title={\ifstrempty{#1}{TIP}{TIP：#1}},
  borderline west={1.5pt}{0pt}{LFSAlertTip}}
\newtcolorbox{important}[1][]{
  lfsalert,colback=LFSAlertImportantBack,colbacktitle=LFSAlertImportantBack,
  coltitle=LFSAlertImportant,title={\ifstrempty{#1}{IMPORTANT}{IMPORTANT：#1}},
  borderline west={1.5pt}{0pt}{LFSAlertImportant}}
\newtcolorbox{warning}[1][]{
  lfsalert,colback=LFSAlertWarningBack,colbacktitle=LFSAlertWarningBack,
  coltitle=LFSAlertWarning,title={\ifstrempty{#1}{WARNING}{WARNING：#1}},
  borderline west={1.5pt}{0pt}{LFSAlertWarning}}
\newtcolorbox{caution}[1][]{
  lfsalert,colback=LFSAlertCautionBack,colbacktitle=LFSAlertCautionBack,
  coltitle=LFSAlertCaution,title={\ifstrempty{#1}{CAUTION}{CAUTION：#1}},
  borderline west={1.5pt}{0pt}{LFSAlertCaution}}
\newtcolorbox{assumption}[1][]{
  lfsalert,colback=LFSAlertImportantBack,colbacktitle=LFSAlertImportantBack,
  coltitle=LFSAlertImportant,title={\ifstrempty{#1}{IMPORTANT}{IMPORTANT：#1}},
  borderline west={1.5pt}{0pt}{LFSAlertImportant}}
\newcounter{algorithm}[chapter]
\renewcommand{\thealgorithm}{\thechapter.\arabic{algorithm}}
\ifdefined\HCode
  % 网页整书直接读取章节正文；章节仍由同一主文件清单决定。
  \RenewDocumentCommand{\subfile}{m}{\input{#1}}
  % 章节图路径原本相对章节文件；整书 HTML 直接 input 时补回章节目录。
  \graphicspath{{chapters/}}
  \let\lfshtmlexample\example
  \let\lfshtmlendexample\endexample
  \RenewDocumentEnvironment{example}{o}{%
    \IfNoValueTF{#1}{\lfshtmlexample}{\lfshtmlexample[#1]}%
    \HCode{<span class="lfs-example-label">例</span>}%
  }{\lfshtmlendexample}
  \NewDocumentEnvironment{algorithm}{O{计算过程}}{%
    \refstepcounter{algorithm}%
    \HCode{<section class="algorithm"><div class="algorithm-title">}%
    算法\thealgorithm\quad #1%
    \HCode{</div>}%
  }{\HCode{</section>}}
\else
  \NewDocumentEnvironment{algorithm}{O{计算过程}}{%
    \refstepcounter{algorithm}%
    \begin{tcolorbox}[lfsbox,title={算法\thealgorithm\quad #1}]%
  }{\end{tcolorbox}}
\fi
% 纸书保留 algorithmicx 的排版；网页使用项目自己的语义列表，避免把
% algorithmicx 的行号盒模型带入 TeX4ht。
\ifdefined\HCode
  \newcommand{\lfswebstate}{\item}
  \newcommand{\lfswebfor}[1]{\item \textbf{对} #1\textbf{，执行}\begin{enumerate}}
  \newcommand{\lfswebendfor}{\end{enumerate}}
  \newcommand{\lfswebwhile}[1]{\item \textbf{当} #1\textbf{ 时，执行}\begin{enumerate}}
  \newcommand{\lfswebendwhile}{\end{enumerate}}
  \newcommand{\lfswebif}[1]{\item \textbf{若} #1\textbf{，则}\begin{enumerate}}
  \newcommand{\lfswebelse}{\end{enumerate}\item \textbf{否则}\begin{enumerate}}
  \newcommand{\lfswebendif}{\end{enumerate}}
  \newcommand{\lfswebreturn}{\textbf{返回：}}
  \NewDocumentEnvironment{lfsalgorithmic}{O{}}{%
    \begingroup
    \let\State\lfswebstate
    \let\For\lfswebfor
    \let\EndFor\lfswebendfor
    \let\While\lfswebwhile
    \let\EndWhile\lfswebendwhile
    \let\If\lfswebif
    \let\Else\lfswebelse
    \let\EndIf\lfswebendif
    \let\Return\lfswebreturn
    \HCode{<div class="algorithm-steps">}\begin{enumerate}%
  }{%
    \end{enumerate}\HCode{</div>}\endgroup
  }
\else
  \NewDocumentEnvironment{lfsalgorithmic}{O{}}{\begin{algorithmic}[#1]}{\end{algorithmic}}
\fi
% 首次定义突出中文规范名；英文全称与缩写保持常规字重，避免整段过度加粗。
% 缩写参数可空。不把英文术语堆进脚注。
\DeclareRobustCommand{\term}[3]{%
  \ifdefined\HCode
    \HCode{<span class="term"><strong>}#1\HCode{</strong><span class="term-en">（}#2%
    \if\relax\detokenize{#3}\relax\else ，#3\fi
    \HCode{）</span></span>}%
  \else
    \textbf{#1}（#2\if\relax\detokenize{#3}\relax\else ，#3\fi）%
  \fi}
% 用于不属于术语定义、但需要读者记住的短结论；不得包裹整段正文。
\DeclareRobustCommand{\keyconcept}[1]{\textbf{#1}}
% 短边注为辅助提示，不承载公式前提、引用或不可缺失的论证。
\newcommand{\bookmargin}[1]{\marginnote{\raggedright\footnotesize\color{LFSNavy}#1}}
% 图题使用非浮动位置，链接锚点落在图题处；表题统一置于表体上方。
\captionsetup{hypcap=false}
\captionsetup[table]{position=top}
\newcommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\DeclareRobustCommand{\bookcode}[1]{\texttt{\seqsplit{#1}}}
\DefineVerbatimEnvironment{verbatim}{Verbatim}{breaklines=true,fontsize=\small}
% 表体统一使用小字号；表题继续由 caption 包独立控制。
\AtBeginEnvironment{tabular}{\small}
\AtBeginEnvironment{tabularx}{\small}
\AtBeginEnvironment{longtable}{\small}
