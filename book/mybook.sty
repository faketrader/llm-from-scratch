\ExplSyntaxOn
\seq_new:N \l_lfs_book_chapter_anchor_seq
\tl_new:N \l_lfs_book_chapter_anchor_tl
\tl_new:N \l_lfs_book_chapter_anchor_type_tl
\tl_new:N \l_lfs_book_chapter_number_tl
\msg_new:nnn { lfs } { invalid-chapter-anchor }
  { Expected~a~chapter~anchor~for~label~`#1',~got~`#2'. }
\cs_new_protected:Npn \lfs_book_set_chapter_from_label:n #1
  {
    \tl_set:Nx \l_lfs_book_chapter_anchor_tl
      { \getrefbykeydefault{lfs-textbook-#1}{anchor}{} }
    \seq_set_split:NnV \l_lfs_book_chapter_anchor_seq {.}
      \l_lfs_book_chapter_anchor_tl
    \seq_pop_left:NN \l_lfs_book_chapter_anchor_seq
      \l_lfs_book_chapter_anchor_type_tl
    \seq_pop_left:NN \l_lfs_book_chapter_anchor_seq
      \l_lfs_book_chapter_number_tl
    \str_if_eq:VnTF \l_lfs_book_chapter_anchor_type_tl { chapter }
      {
        \setcounter{chapter}
          { \int_eval:n { \l_lfs_book_chapter_number_tl - 1 } }
      }
      {
        \msg_error:nnee { lfs } { invalid-chapter-anchor }
          {#1} { \l_lfs_book_chapter_anchor_tl }
      }
  }
\NewDocumentCommand{\lfssetchapterfromlabel}{m}
  { \lfs_book_set_chapter_from_label:n {#1} }
\ExplSyntaxOff
% 章间引用只写稳定标签；单章从教材 AUX 取得编号、标题与外部链接。
\NewDocumentCommand{\bookxref}{m O{}}{%
  \ifdefined\HCode
  \ifcsname r@#1\endcsname
  \HCode{<a class="lfs-bookxref" data-label="#1">}第\getrefnumber{#1}章《\getrefbykeydefault{#1}{name}{#1}》\HCode{</a>}%
  \else
  \ifcsname r@lfs-textbook-#1\endcsname
  \HCode{<a class="lfs-bookxref" data-label="#1">}第\getrefnumber{lfs-textbook-#1}章《\getrefbykeydefault{lfs-textbook-#1}{name}{#1}》\HCode{</a>}%
  \else
  \PackageWarning{mybook}{Unknown book cross-reference `#1'}\texttt{#1}%
  \fi
  \fi
  \else
  \ifcsname r@#1\endcsname
  \hyperref[#1]{第\ref*{#1}章《\nameref*{#1}》}%
  \else
  \ifcsname r@lfs-textbook-#1\endcsname
  \hyperref[lfs-textbook-#1]{第\ref*{lfs-textbook-#1}章《\nameref*{lfs-textbook-#1}》}%
  \else
  \PackageWarning{mybook}{Unknown book cross-reference `#1'}\texttt{#1}%
  \fi
  \fi
  \fi#2}
\NewDocumentCommand{\bookxrefshort}{m}{%
  \ifdefined\HCode
  \ifcsname r@#1\endcsname
  \HCode{<a class="lfs-bookxref" data-label="#1">}第\getrefnumber{#1}章\HCode{</a>}%
  \else
  \ifcsname r@lfs-textbook-#1\endcsname
  \HCode{<a class="lfs-bookxref" data-label="#1">}第\getrefnumber{lfs-textbook-#1}章\HCode{</a>}%
  \else
  \PackageWarning{mybook}{Unknown short book cross-reference `#1'}\texttt{#1}%
  \fi
  \fi
  \else
  \ifcsname r@#1\endcsname
  \hyperref[#1]{第\ref*{#1}章}%
  \else
  \ifcsname r@lfs-textbook-#1\endcsname
  \hyperref[lfs-textbook-#1]{第\ref*{lfs-textbook-#1}章}%
  \else
  \PackageWarning{mybook}{Unknown short book cross-reference `#1'}\texttt{#1}%
  \fi
  \fi
  \fi}
