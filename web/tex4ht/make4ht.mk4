-- HTML5 permits colons in IDs. Keep the book's semantic labels intact.
local domfilter = require 'make4ht-domfilter'
Make:match('html?$', domfilter({'fixinlines', 'joincharacters', 'tablecaption', 'mathmlfixes', 'tablerows', 'booktabs', 'itemparagraphs'}))
